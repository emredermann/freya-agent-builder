        "threshold": 0.3,
        "reduction": "min",
        "disableOnDigitNodes": true,
        "reaskMode": "phrase",
        "reaskPhrases": null,
        "maxConsecutiveReasks": 2
      }
    },
    "complianceConfig": {
      "pciDss": false,
      "mifidIi": false,
      "euAiAct": false,
      "soc2": false
